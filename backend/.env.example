# Copie este arquivo para .env e preencha com valores reais (não versionar .env).
# Em produção, defina essas variáveis no ambiente/orquestrador — não use arquivo .env.

# Profile ativo: dev ou prod (default: dev)
SPRING_PROFILES_ACTIVE=dev

# Banco de dados PostgreSQL
DB_URL=jdbc:postgresql://localhost:5433/lmsdb
DB_USERNAME=lms
DB_PASSWORD=

# JWT — gere um valor aleatorio forte (>= 64 bytes) para producao, ex: openssl rand -hex 64
JWT_SECRET=

# Admin de conveniencia para teste manual em dev (ver DevAdminSeeder, so roda sob
# o profile "dev" — nunca em prod). Opcional: sem isso, cai no default de
# application-dev.properties (dev_only_troque_local_123), que so serve para uso
# local.
DEV_ADMIN_PASSWORD=
