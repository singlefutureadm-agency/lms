# Claude — configuração local da ferramenta, não versionada.
# CLAUDE.md NÃO entra aqui: é a documentação de contexto do projeto (sucessora
# do CONTEXTO_PROJETO.md), lida automaticamente por agentes no início de cada
# sessão. Ignorá-la faria com que um clone novo perdesse justamente o arquivo
# que existe para dar contexto.
.claude/
**/.claude/
.claude.json

# Backend
backend/target/
backend/*.class
backend/*.jar
backend/*.war
backend/.idea/
backend/*.iml
backend/application-local.yml
backend/*.log
backend/.env

# Frontend
frontend/node_modules/
frontend/dist/
frontend/.angular/
frontend/*.log
frontend/.env
frontend/e2e/.env.e2e

# Sistema
.DS_Store
Thumbs.db
*.log
hs_err_pid*.log

# Scripts e screenshots de sessão de testes (somente raiz)
/ss_*.js
/ss_*.png
/[0-9][0-9]_*.png

# IDE / runtime
/.idea/
/backend/uploads/
