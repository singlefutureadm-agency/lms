# Copie este arquivo para frontend/e2e/.env.e2e (não versionar .env.e2e).
# apoio.ts carrega este arquivo automaticamente se ele existir; variáveis já
# definidas no shell/CI têm prioridade sobre o que está aqui.

# Credenciais do admin dedicado aos testes E2E — nunca um usuário pessoal.
E2E_ADMIN_EMAIL=e2e.admin@lms.local
E2E_ADMIN_PASSWORD=

# Conexão direta com o Postgres de teste, usada só para promover o admin E2E a
# ADMIN na primeira vez (ver README.md). DB_USERNAME/DB_PASSWORD já vêm de
# backend/.env — normalmente não é preciso repetir aqui.
# E2E_DB_HOST=localhost
# E2E_DB_PORT=5433
# E2E_DB_NAME=lmsdb
